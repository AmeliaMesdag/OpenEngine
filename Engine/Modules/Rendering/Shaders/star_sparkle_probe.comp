#version 450

// Test-only probe for the night sky's star sparkle (StarSparkleShapeTests).
//
// The property under test is the outline a clipping exposure leaves on screen, which is a
// level set of GE_StarSparkle. It is a statement about the shipped GLSL, so the sparkle is
// evaluated HERE, on the device, and the CPU only reads the profiles back.
//
// Dispatched with 2 * sampleCount + circleCount invocations. Invocation i < sampleCount
// samples the ray along a point (+x); the next sampleCount sample the diagonal between two
// points; each ray's sample k sits at radius (k + 0.5) / sampleCount. The last circleCount
// invocations sample the unit circle, where the sparkle must already be zero.

#include "Includes/star_sparkle.glsl"

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) buffer ProbeOut { vec4 result[]; } uOut;

layout(push_constant) uniform ProbePC
{
    // x = core radius, y = point amount, z = core size, w = falloff.
    vec4 shape;
    // x = samples per ray, y = samples on the unit circle; zw unused.
    vec4 counts;
} pc;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    uint samples = uint(pc.counts.x);
    uint circle = uint(pc.counts.y);
    if (i >= 2u * samples + circle)
        return;

    vec2 q;
    float radius;
    if (i < 2u * samples)
    {
        uint k = i % samples;
        radius = (float(k) + 0.5) / float(samples);
        vec2 direction = (i < samples) ? vec2(1.0, 0.0) : vec2(0.70710678, 0.70710678);
        q = direction * radius;
    }
    else
    {
        float angle = 6.28318531 * float(i - 2u * samples) / float(circle);
        radius = 1.0;
        q = vec2(cos(angle), sin(angle));
    }

    uOut.result[i] = vec4(radius, GE_StarSparkle(q, pc.shape.x, pc.shape.y, pc.shape.z, pc.shape.w), 0.0, 0.0);
}
