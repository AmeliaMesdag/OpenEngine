#version 450

// Test-only probe for each star's twinkle range (StarTwinkleRangeTests). The range is drawn from
// a hash in the shipped GLSL, so the distribution is measured on the device: invocation i writes
// star i's range and its brightness at the low phase and at the peak.

#include "Includes/star_sparkle.glsl"

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) buffer ProbeOut { vec4 result[]; } uOut;

layout(push_constant) uniform ProbePC
{
    // x = star count; yzw unused.
    vec4 counts;
} pc;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.counts.x))
        return;
    vec2 range = GE_StarTwinkleRange(i);
    uOut.result[i] = vec4(range, GE_StarTwinkleBrightness(range, 0.0), GE_StarTwinkleBrightness(range, 1.0));
}
