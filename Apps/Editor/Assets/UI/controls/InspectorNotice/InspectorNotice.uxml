<!-- InspectorNotice (Apps/Editor/Include/UI/Controls/InspectorNotice.h): the plate, its heading (a
     glyph and a title, hidden until the notice is given a title), its text, its action and its
     dismiss. The classes are the contract with InspectorNotice.cpp. No ids: focus is tracked by id,
     and every notice's buttons have to stay focus targets of their own. The action and the dismiss
     stay hidden and without text until the notice is given them, so a scan of a notice's text reads
     only what it shows. -->
<UIElement class="inspector-notice-plate">
  <UIElement class="inspector-notice-heading hidden">
    <UIElement class="inspector-notice-glyph" />
    <Label class="inspector-notice-title" />
  </UIElement>
  <Label class="inspector-notice-text" />
  <Button class="inspector-notice-action small hidden" />
  <Button class="inspector-notice-dismiss small hidden" />
</UIElement>
