<!-- ScriptPackagesList (Apps/Editor/Source/Editor/Settings/ScriptPackages/ScriptPackagesList.h): the Script Packages
     page's list of the scripts csproj's packages (one ScriptPackageRow.uxml each), the row that adds
     a package, and the status line. The classes are the contract with ScriptPackagesList.cpp. -->
<UIElement class="script-packages">
  <UIElement class="script-packages-rows" />
  <UIElement class="script-packages-row">
    <TextField class="settings-row-field script-packages-id script-packages-new-id" />
    <TextField class="settings-row-field script-packages-version script-packages-new-version" />
    <Button class="script-packages-add">Add Package</Button>
  </UIElement>
  <Label class="settings-description script-packages-status" />
</UIElement>
