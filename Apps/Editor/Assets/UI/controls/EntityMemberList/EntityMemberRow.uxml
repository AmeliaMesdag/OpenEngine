<!-- One row of EntityMemberList: the glyph and the title in the inspector's label column; the member
     checkbox, the note and the mode as two segments or as one label in its value column. The control
     hides the parts a row does not use. The classes are the contract with EntityMemberList.cpp. -->
<UIElement class="inspector-row entity-member-row">
  <UIElement class="inspector-label-cell entity-member-name">
    <UIElement class="entity-member-glyph" />
    <Label class="entity-member-title" />
  </UIElement>
  <UIElement class="inspector-field entity-member-value">
    <Toggle class="entity-member-toggle" />
    <Label class="entity-member-note" />
    <UIElement class="entity-member-mode">
      <Button class="segmented-button entity-member-segment" />
      <Button class="segmented-button entity-member-segment" />
      <Label class="entity-member-mode-label" />
    </UIElement>
  </UIElement>
</UIElement>
