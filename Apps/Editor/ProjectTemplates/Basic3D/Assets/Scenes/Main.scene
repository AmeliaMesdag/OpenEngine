[entity id="post_process_volume"]
; Horizon haze in the sky's own horizon color at every time of day. It starts 150 m out and is
; dense only in the last few degrees below the horizon, from the default camera and from 40 m up.
; The ground reaches 3000 m from the origin, the Main Camera's far clip. Past the fog's maxDistance
; the ground is fogged to 97.5 percent while the sky fill below the horizon reaches 98 percent, so by
; day the end of the ground does not show; that 0.5-point gap is the fog model's, not the far clip's,
; and under the Scene View's brighter night exposure it still reads as a faint line where the ground ends.
HeightFogEffect.enabled = true
HeightFogEffect.intensity = 1
HeightFogEffect.density = 1
HeightFogEffect.maxOpacity = 1
HeightFogEffect.minDistance = 150
HeightFogEffect.smoothLength = 150
HeightFogEffect.maxDistance = 3000
HeightFogEffect.heightFogEnabled = false
HeightFogEffect.colorMode = 1
HeightFogEffect.skyFillEnd = 0.05
